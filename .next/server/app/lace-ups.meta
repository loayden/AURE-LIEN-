{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/lace-ups/layout,_N_T_/lace-ups/page,_N_T_/lace-ups"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/lace-ups/__PAGE__",
    "/lace-ups",
    "/_index",
    "/_head"
  ]
}